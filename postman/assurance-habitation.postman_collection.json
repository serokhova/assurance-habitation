    {
      "name": "1. Policyholders (Users)",
      "description": "Endpoints for managing insured policyholders (/users).",
      "item": [
        {
          "name": "Create Policyholder (Triggers USER_CREATED JMS Event)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('user_id', json.id);",
                  "    console.log('Saved user_id:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sophie Martin\",\n  \"email\": \"sophie.martin.\" + Date.now() + \"@example.com\",\n  \"phoneNumber\": \"+33612345678\"\n}"
            },
            "url": {
              "raw": "{{assurance_url}}/users",
              "host": ["{{assurance_url}}"],
              "path": ["users"]
            },
            "description": "Creates a new policyholder and publishes a USER_CREATED event to Artemis queue user.created.queue."
          }
        },
        {
          "name": "List All Policyholders",
          "request": {
            "method": "GET",
