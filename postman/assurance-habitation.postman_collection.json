    {
      "name": "6. Audit Events (audit-consumer)",
      "description": "Endpoints on port 8081 for inspecting asynchronously consumed JMS events (/events).",
      "item": [
        {
          "name": "List All Consumed Events (Audit Trail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var list = pm.response.json();",
                  "    if (list && list.length > 0) {",
                  "        pm.collectionVariables.set('event_id', list[0].id);",
                  "        console.log('Saved latest event_id:', list[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{audit_url}}/events",
              "host": ["{{audit_url}}"],
              "path": ["events"]
            },
            "description": "Returns the complete chronological history of consumed JMS audit events."
          }
        },
        {
          "name": "Get Audit Event by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{audit_url}}/events/{{event_id}}",
              "host": ["{{audit_url}}"],
              "path": ["events", "{{event_id}}"]
            },
            "description": "Fetches a specific audit log record including original emission time and reception timestamp."
          }
        }
      ]
    }
